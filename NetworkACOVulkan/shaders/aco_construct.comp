#version 450
layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer Obstacles { uint obstacles[]; };
layout(std430, binding = 1) readonly buffer Goals { uint goals[]; };
layout(std430, binding = 3) readonly buffer TotalPheromone { uint totalPheromone[]; };
layout(std430, binding = 4) readonly buffer PheromoneByAnt { uint pheromoneByAnt[]; };
layout(std430, binding = 5) buffer PathNodes { uint pathNodes[]; };
layout(std430, binding = 6) buffer PathLengths { uint pathLengths[]; };
layout(std430, binding = 7) buffer PathCosts { float pathCosts[]; };
layout(std430, binding = 8) buffer ReachedGoal { uint reachedGoal[]; };
layout(std430, binding = 9) buffer InteractionCurrent { float interactionCurrent[]; };
layout(std430, binding = 12) readonly buffer Control {
    uint iteration; uint width; uint height; uint obstacleCount;
    uint antCount; uint maxPath; uint maxIterations; uint startNode;
    uint goalCount; uint tileWidth; uint tileHeight; uint seed;
    float alpha; float beta; float rho; float depositQ;
    float initialPheromone; uint guidedMode; uint visitedCapacity; uint t1SearchTicks;
    float odorRadius; float odorStrength;
    uint odorEnabled; uint generationSearchTicks;
};
layout(std430, binding = 14) buffer VisitedHash { uvec2 visitedHash[]; };
layout(std430, binding = 15) buffer SimplePaths { uint simplePaths[]; };
layout(std430, binding = 16) buffer SimpleLengths { uint simpleLengths[]; };
layout(std430, binding = 17) buffer AntStates { uvec4 antStates[]; };
layout(std430, binding = 18) buffer PathStarts { uint pathStarts[]; };

const uint SEARCHING = 0u;
const uint REACHED_NEW = 1u;
const uint MOVES_PER_BLOCK = 2048u;
const uint VISIT_BITS = 18u;
const uint VISIT_MASK = (1u << VISIT_BITS) - 1u;

uint hashValue(uint value) {
    value ^= value >> 16; value *= 0x7feb352du;
    value ^= value >> 15; value *= 0x846ca68bu;
    value ^= value >> 16; return value;
}

float randomUnit(uint ant, uint step, uint attempt) {
    uint bits = hashValue(seed ^ (iteration * 0x9e3779b9u) ^ (generationSearchTicks * 0x27d4eb2du)
        ^ (ant * 0x85ebca6bu) ^ (step * 0xc2b2ae35u) ^ (attempt * 0x165667b1u));
    return float(bits & 0x00ffffffu) / 16777216.0;
}

bool isBlocked(uint node) {
    uint low = 0u;
    uint high = obstacleCount;
    while (low < high) {
        uint middle = low + (high - low) / 2u;
        uint value = obstacles[middle];
        if (value < node) low = middle + 1u;
        else high = middle;
    }
    return low < obstacleCount && obstacles[low] == node;
}

uint pheromoneSlot(uint from, uint direction) {
    uint x = from % width;
    uint y = from / width;
    uint tileX = min(tileWidth - 1u, uint(float(x) * float(tileWidth) / float(width)));
    uint tileY = min(tileHeight - 1u, uint(float(y) * float(tileHeight) / float(height)));
    return (tileY * tileWidth + tileX) * 4u + direction;
}

uint manhattan(uint node, uint goal) {
    uint x0 = node % width; uint y0 = node / width;
    uint x1 = goal % width; uint y1 = goal / width;
    return (x0 > x1 ? x0 - x1 : x1 - x0) + (y0 > y1 ? y0 - y1 : y1 - y0);
}

float odorConcentration(uint node, uint goal) {
    if (odorEnabled == 0u || odorRadius <= 0.0) return 0.0;
    float distance = float(manhattan(node, goal));
    if (distance >= odorRadius) return 0.0;
    float remaining = 1.0 - distance / odorRadius;
    return remaining * remaining;
}

uint visitStamp(uint attempt) {
    // Every uninterrupted traversal keeps its private taboo set between GPU
    // blocks. An exhausted explorer gets a new stamp but remains in the same T.
    return 1u + iteration * 16384u + attempt;
}

bool wasVisited(uint ant, uint node, uint stamp) {
    uint mask = visitedCapacity - 1u;
    uint slot = hashValue(node) & mask;
    uint tableOffset = ant * visitedCapacity;
    for (uint probe = 0u; probe < visitedCapacity; ++probe) {
        uvec2 entry = visitedHash[tableOffset + slot];
        if (entry.y != stamp) return false;
        if (entry.x == node) return true;
        slot = (slot + 1u) & mask;
    }
    return false;
}

void rememberVisited(uint ant, uint node, uint stamp) {
    uint mask = visitedCapacity - 1u;
    uint slot = hashValue(node) & mask;
    uint tableOffset = ant * visitedCapacity;
    for (uint probe = 0u; probe < visitedCapacity; ++probe) {
        uvec2 entry = visitedHash[tableOffset + slot];
        if (entry.y != stamp || entry.x == node) {
            visitedHash[tableOffset + slot] = uvec2(node, stamp);
            return;
        }
        slot = (slot + 1u) & mask;
    }
}

void main() {
    uint ant = gl_GlobalInvocationID.x;
    if (ant >= antCount || goalCount == 0u || iteration >= maxIterations) return;
    uint assignedGoal = ant % goalCount;
    uint goal = goals[assignedGoal];
    uvec4 state = antStates[ant]; // current, active path length, status, unique visits
    uint current = state.x;
    uint length = state.y;
    uint attempt = state.w >> VISIT_BITS;
    uint uniqueVisits = state.w & VISIT_MASK;
    uint moves = 0u;
    uint pathOffset = ant * maxPath;
    uint routeIndex = iteration * antCount + ant;
    pathStarts[ant] = current;
    pathLengths[routeIndex] = 0u;
    if (state.z != SEARCHING) return;

    uint stamp = visitStamp(attempt);
    rememberVisited(ant, current, stamp);
    uint moveBudget = min(MOVES_PER_BLOCK, maxPath);

    while (current != goal && moves < moveBudget) {
        uint x = current % width;
        uint y = current / width;
        uint possible[4] = uint[4](x > 0u ? current - 1u : 0xffffffffu,
                                   x + 1u < width ? current + 1u : 0xffffffffu,
                                   y > 0u ? current - width : 0xffffffffu,
                                   y + 1u < height ? current + width : 0xffffffffu);
        bool valid[4];
        bool canDiscover = uniqueVisits < min(visitedCapacity / 2u, VISIT_MASK) && length < maxPath;
        for (uint direction = 0u; direction < 4u; ++direction) {
            uint next = possible[direction];
            valid[direction] = canDiscover && next != 0xffffffffu && !isBlocked(next)
                && !wasVisited(ant, next, stamp);
        }
        uint candidates[4];
        uint directions[4];
        float weights[4];
        uint count = 0u;
        uint currentDistance = guidedMode != 0u ? manhattan(current, goal) : 0u;
        float currentOdor = odorConcentration(current, goal);
        float totalWeight = 0.0;
        for (uint direction = 0u; direction < 4u; ++direction) {
            uint next = possible[direction];
            if (!valid[direction]) continue;
            float heuristic = 1.0;
            if (guidedMode != 0u) {
                uint nextDistance = manhattan(next, goal);
                heuristic *= nextDistance < currentDistance ? 6.0 : 0.35;
            }
            if (odorEnabled != 0u) {
                // Volatile-food field: outside the detection radius there is no
                // directional information. Inside it, only a locally stronger
                // concentration attracts the ant; weaker concentration repels it.
                float nextOdor = odorConcentration(next, goal);
                if (nextOdor > currentOdor) {
                    heuristic *= 1.0 + odorStrength * nextOdor;
                } else if (nextOdor < currentOdor) {
                    heuristic /= 1.0 + odorStrength * currentOdor;
                }
            }
            uint slot = pheromoneSlot(current, direction);
            // Fixed point uses 16 fractional bits. The old 1.0 clamp made all
            // evaporated cells look as strong as the initial trail forever,
            // erasing the contrast learned by ACO. Keep only one fixed-point
            // quantum as the numerical floor.
            float pheromone = max(1.0 / 65536.0,
                                  float(totalPheromone[slot]) / 65536.0);
            float weight = pow(pheromone, alpha) * pow(heuristic, beta);
            candidates[count] = next;
            directions[count] = direction;
            weights[count] = weight;
            totalWeight += weight;
            ++count;
        }
        if (count > 0u) {
            float target = randomUnit(ant, moves, attempt) * totalWeight;
            float cumulative = 0.0;
            uint selected = count - 1u;
            for (uint index = 0u; index < count; ++index) {
                cumulative += weights[index];
                if (target <= cumulative) { selected = index; break; }
            }
            uint slot = pheromoneSlot(current, directions[selected]);
            uint contributionOffset = slot * antCount;
            for (uint source = 0u; source < antCount; ++source) {
                if (source == ant) continue;
                interactionCurrent[source * antCount + ant] +=
                    float(pheromoneByAnt[contributionOffset + source]) / 65536.0;
            }
            current = candidates[selected];
            simplePaths[pathOffset + length] = current;
            ++length;
            ++uniqueVisits;
            rememberVisited(ant, current, stamp);
        } else if (length > 0u) {
            // Grid repair: return deterministically to the previous branch.
            // Visited cells never re-enter the roulette and the active route
            // used for cost/deposit remains a simple, cycle-free path.
            current = length == 1u ? startNode : simplePaths[pathOffset + length - 2u];
            --length;
        } else {
            state.z = 3u;
            break;
        }
        pathNodes[pathOffset + moves] = current;
        ++moves;
    }
    if (current == goal) state.z = REACHED_NEW;
    state.x = current;
    state.y = length;
    state.w = (attempt << VISIT_BITS) | uniqueVisits;
    antStates[ant] = state;
    pathLengths[routeIndex] = moves;
    pathCosts[routeIndex] = float(length);
    reachedGoal[routeIndex] = state.z == REACHED_NEW ? assignedGoal + 1u : 0u;
    simpleLengths[ant] = length;
}
